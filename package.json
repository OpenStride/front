{
  "name": "openStride",
  "version": "0.5.59",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "cross-env VITE_APP_BASE_URL=https://openstride.org vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,json,md}\"",
    "test:unit": "vitest",
    "test:e2e": "cypress run",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy-firebase.ps1",
    "deploy:bash": "bash deploy-firebase.sh",
    "deploy:firebase": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "chart.js": "^4.6.1",
    "core-js": "^3.51.0",
    "fit-file-parser": "^2.3.3",
    "fit-parser": "^0.10.1",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "pako": "^2.1.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "cross-env": "^7.0.3",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.3.7",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.14",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
